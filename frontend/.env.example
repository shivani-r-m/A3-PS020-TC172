# Copy to .env.local (Windows PowerShell: Copy-Item .env.example .env.local) and adjust.
# Restart `npm run dev` after changing it - Vite reads this file at start-up.

# Base URL of the FastAPI backend (no trailing slash).
#   Backend on this machine .................. http://localhost:8000
#   Backend in the Ubuntu VM (port-forwarded)  http://localhost:8000   (VirtualBox NAT rule host 8000 -> guest 8000)
#   Backend in the VM (bridged / host-only) .. http://<VM-IP>:8000
# Leave empty to run in demo mode (no network requests are made).
VITE_API_BASE_URL=http://localhost:8000

# Optional. Set to "true" to force the demo fallback even if VITE_API_BASE_URL is set.
VITE_USE_MOCK=

# Optional. Per-request timeout in milliseconds (default 8000).
VITE_API_TIMEOUT_MS=
